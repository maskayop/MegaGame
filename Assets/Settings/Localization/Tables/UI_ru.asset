    m_Localized: "\u041F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0437\u0434\u0430\u043D\u0438\u0435
      \u0437\u0430 "
    m_Metadata:
      m_Items: []
  - m_Id: 3610151817216
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0432 \u0433\u043B\u0430\u0432\u043D\u043E\u0435
      \u043C\u0435\u043D\u044E?"
    m_Metadata:
      m_Items: []
  - m_Id: 4226987134976
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0438\u0433\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 4236629839872
    m_Localized: "\u0412\u044B\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 5258915942400
    m_Localized: "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0438\u043C\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 5332920242176
    m_Localized: "\u041F\u0435\u0440\u0435\u0438\u043C\u0435\u043D\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 5400733749248
    m_Localized: "\u0423\u0434\u0430\u043B\u0438\u0442\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5363127619584
    m_Localized: "\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043A\u0430\u043C\u043F\u0430\u043D\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 6259404247040
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u0438\u0437 \u0438\u0433\u0440\u044B?"
    m_Metadata:
      m_Items: []
  - m_Id: 333940981305344
    m_Localized: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 362057347174400
    m_Localized: "\u041A\u0430\u0442\u0430\u043B\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 604705492373504
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u0437\u0430 "
    m_Metadata:
      m_Items: []
  - m_Id: 643046946443264
    m_Localized: "\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 714320838201344
    m_Localized: "\u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441 \u0442\u0435\u043A\u0443\u0449\u0435\u0439
      \u0431\u0438\u0442\u0432\u044B \u0431\u0443\u0434\u0435\u0442 \u0443\u0442\u0435\u0440\u044F\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 1052854216364032
    m_Localized: "\u041F\u043E\u0441\u043B\u0430\u0442\u044C \u0448\u043F\u0438\u043E\u043D\u043E\u0432
      \u0432\u043E \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435 \u043F\u043E\u0440\u0442\u044B?\n\n<color=#FFFFFF>\u042D\u0442\u043E
      \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u0432\u0438\u0434\u0435\u0442\u044C \u0440\u0435\u0441\u0443\u0440\u0441\u044B
      \u0432\u0440\u0430\u0433\u0430 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u043E\u0434\u043D\u043E\u0439 \u0431\u0438\u0442\u0432\u044B.\n\u0421\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
      \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
      \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445 \u043F\u043E\u0440\u0442\u043E\u0432\n</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2051063634006016
    m_Localized: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F
      \u0431\u044B\u043B\u0438 \u0441\u0433\u0435\u043D\u0435\u0440\u0438\u0440\u043E\u0432\u0430\u043D\u044B
      \u0438\u043B\u0438 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u044B
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0418\u0418"
    m_Metadata:
      m_Items: []
  - m_Id: 2054715362840576
    m_Localized: "\u041C\u0435\u043D\u044F \u044D\u0442\u043E \u043D\u0435 \u0441\u043C\u0443\u0449\u0430\u0435\u0442!\n\u0417\u0430\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0438\u0433\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2054766403325952
    m_Localized: "\u042D\u0442\u043E \u043E\u0441\u043A\u043E\u0440\u0431\u0438\u0442\u0435\u043B\u044C\u043D\u043E!\n\u0412\u044B\u0439\u0442\u0438
      \u0438\u0437 \u0438\u0433\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2393996019175424
    m_Localized: "\u041F\u0440\u0438\u0432\u0435\u0442!\n\u042F \u044F\u0432\u043B\u044F\u044E\u0441\u044C
      \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u043E\u043C,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043B\u044E\u0431\u0438\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0435
      \u0438\u0433\u0440\u044B \u0438 \u043D\u0435\u043D\u0430\u0432\u0438\u0434\u0438\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u0432 \u043B\u0438\u0446\u043E \u043F\u0438\u0445\u0430\u044E\u0442
      \u043D\u0435\u043D\u0443\u0436\u043D\u0443\u044E \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E.\n\u041C\u043E\u044F
      \u0446\u0435\u043B\u044C - \u0434\u0435\u043B\u0430\u0442\u044C \u043A\u043B\u0430\u0441\u0441\u043D\u044B\u0435
      \u0438\u0433\u0440\u044B, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0438\u0433\u0440\u0430\u0442\u044C,
      \u043D\u0435 \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u044F\u0441\u044C \u043F\u0440\u0438
      \u044D\u0442\u043E\u043C \u043D\u0430 \u0432\u0441\u044F\u043A\u0443\u044E
      \u0435\u0440\u0443\u043D\u0434\u0443.\n\u041F\u043E\u044D\u0442\u043E\u043C\u0443
      \u044F \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438\u0430\u043B\u044C\u043D\u043E
      \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E \u0432 \u0438\u0433\u0440\u0443
      \u0440\u0435\u043A\u043B\u0430\u043C\u0443, \u0447\u0442\u043E\u0431\u044B
      \u0438\u0433\u0440\u043E\u043A \u043C\u043E\u0433 \u0441 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043E\u043C
      \u0438 \u043F\u043E\u043B\u043D\u044B\u043C \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0434\u043B\u044F \u0441\u0435\u0431\u044F
      \u043D\u043E\u0432\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439
      \u043C\u0438\u0440 \u0438\u0433\u0440\u044B.\n\u0415\u0441\u043B\u0438 \u0412\u0430\u043C
      \u0431\u043B\u0438\u0437\u043A\u0430 \u043C\u043E\u044F \u043F\u043E\u0437\u0438\u0446\u0438\u044F,
      \u0438 \u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043C\u0435\u043D\u044F, \u0442\u043E \u043C\u043E\u0436\u0435\u0442\u0435
      \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C, \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0432
      \u043F\u043E\u043A\u0443\u043F\u043A\u0443 \u0432 \u041A\u0430\u0442\u0430\u043B\u043E\u0433\u0435
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432.\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 2397459969019904
    m_Localized: "\u041F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2397501387771904
    m_Localized: "\u042F \u0435\u0449\u0451 \u043F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 4607901776809984
    m_Localized: "\u0423\u0441\u043F\u0435\u0448\u043D\u0430\u044F \u043F\u043E\u043A\u0443\u043F\u043A\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 4609959196168192
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C
      \u043F\u043E\u043A\u0443\u043F\u043A\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 6062456007888896
    m_Localized: "\u041F\u043E\u0431\u0435\u0434\u0430!\n\u041C\u044B \u0432 \u0432\u0430\u0441
      \u0438 \u043D\u0435 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u043B\u0438\u0441\u044C,
      \u041A\u0430\u043F\u0438\u0442\u0430\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 6062483853873152
    m_Localized: "\u041F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435!\n\u041C\u044B
      \u0432 \u0432\u0430\u0441 \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u044B,
      \u041A\u0430\u043F\u0438\u0442\u0430\u043D!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
