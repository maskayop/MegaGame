    m_Localized: Large Port Fort
    m_Metadata:
      m_Items: []
  - m_Id: 14169960243859456
    m_Localized: Small Port Fort
    m_Metadata:
      m_Items: []
  - m_Id: 14170128930377728
    m_Localized: Pirate Settlement
    m_Metadata:
      m_Items: []
  - m_Id: 14170914229915648
    m_Localized: Defensive structure with powerful weapons
    m_Metadata:
      m_Items: []
  - m_Id: 14171073122734080
    m_Localized: 'Automatically builds a Merchant Ship that trades between friendly
      islands.

      Only one Merchant Ship can exist per port that has this building'
    m_Metadata:
      m_Items: []
  - m_Id: 14171126738522112
    m_Localized: 'Large port settlement where ships can be built.

      Provides
      good income every day.

      Has strong defensive weapons'
    m_Metadata:
      m_Items: []
  - m_Id: 14171160276176896
    m_Localized: 'Medium port settlement where ships can be built.

      Provides
      medium income every day.

      Has medium defensive weapons'
    m_Metadata:
      m_Items: []
  - m_Id: 14171190483554304
    m_Localized: 'Defensive structure with powerful weapons.

      Can be built
      in a port. Adds damage, durability, and recovery, but requires daily upkeep'
    m_Metadata:
      m_Items: []
  - m_Id: 14171221789839360
    m_Localized: 'Defensive structure with powerful weapons.

      Can be built
      in a port. Adds damage, durability, and recovery, but requires daily upkeep'
    m_Metadata:
      m_Items: []
  - m_Id: 14171252051742720
    m_Localized: 'Small settlement where ships cannot be built.

      Provides
      a small income every day.

      Has no defensive weapons'
    m_Metadata:
      m_Items: []
  - m_Id: 14171282363977728
    m_Localized: 'Settlement of pirates and brigands.

      Sends pirates on raiding
      parties to small settlements and merchant ships.

      Destroying the settlement
      helps recover stolen goods and brings a small profit to the treasury'
    m_Metadata:
      m_Items: []
