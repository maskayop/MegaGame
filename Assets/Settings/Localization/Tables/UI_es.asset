  m_TableData:
  - m_Id: 46046187520
    m_Localized: 'Construir este edificio por '
    m_Metadata:
      m_Items: []
  - m_Id: 3610151817216
    m_Localized: "\xBFVolver al men\xFA principal?"
    m_Metadata:
      m_Items: []
  - m_Id: 4226987134976
    m_Localized: Comenzar juego
    m_Metadata:
      m_Items: []
  - m_Id: 4236629839872
    m_Localized: Salir
    m_Metadata:
      m_Items: []
  - m_Id: 5258915942400
    m_Localized: Ingrese nombre...
    m_Metadata:
      m_Items: []
  - m_Id: 5332920242176
    m_Localized: Renombrar
    m_Metadata:
      m_Items: []
  - m_Id: 5363127619584
    m_Localized: "Crear campa\xF1a"
    m_Metadata:
      m_Items: []
  - m_Id: 5400733749248
    m_Localized: "\xBFEliminar todas las partidas?"
    m_Metadata:
      m_Items: []
  - m_Id: 6259404247040
    m_Localized: "\xBFSalir del juego?"
    m_Metadata:
      m_Items: []
  - m_Id: 333940981305344
    m_Localized: Tienda
    m_Metadata:
      m_Items: []
  - m_Id: 362057347174400
    m_Localized: "Cat\xE1logo"
    m_Metadata:
      m_Items: []
  - m_Id: 604705492373504
    m_Localized: 'Desbloquear por '
    m_Metadata:
      m_Items: []
  - m_Id: 643046946443264
    m_Localized: Adquirido
    m_Metadata:
      m_Items: []
  - m_Id: 714320838201344
    m_Localized: "Se perder\xE1 el progreso de la batalla actual"
    m_Metadata:
      m_Items: []
  - m_Id: 1052854216364032
    m_Localized: "\xBFEnviar esp\xEDas a los puertos enemigos?\n\n<color=#FFFFFF>\nEsto
      permitir\xE1 ver los recursos enemigos durante una batalla.\nEl costo depende
      de la cantidad de puertos enemigos\n</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 2051063634006016
    m_Localized: "Algunas im\xE1genes fueron generadas o procesadas con IA"
    m_Metadata:
      m_Items: []
  - m_Id: 2054715362840576
    m_Localized: "\xA1No me molesta!\nIniciar el juego"
    m_Metadata:
      m_Items: []
  - m_Id: 2054766403325952
    m_Localized: "\xA1Esto es ofensivo!\nSalir del juego"
    m_Metadata:
      m_Items: []
  - m_Id: 2397459969019904
    m_Localized: Apoyar
    m_Metadata:
      m_Items: []
  - m_Id: 2397501387771904
    m_Localized: "Lo pensar\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 4607901776809984
    m_Localized: "\xA1Compra exitosa!"
    m_Metadata:
      m_Items: []
  - m_Id: 4609959196168192
    m_Localized: "\xA1No se pudo completar la compra!"
    m_Metadata:
      m_Items: []
  - m_Id: 6062456007888896
    m_Localized: "\xA1Victoria!\nNunca dudamos de usted, \xA1Capit\xE1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 6062483853873152
    m_Localized: "\xA1Derrota!\nEstamos decepcionados con usted, \xA1Capit\xE1n!"
    m_Metadata:
      m_Items: []
  - m_Id: 6354334670458880
    m_Localized: "Campa\xF1as"
    m_Metadata:
      m_Items: []
  - m_Id: 6427000718823424
    m_Localized: "\xBFCargar campa\xF1a?"
    m_Metadata:
      m_Items: []
  - m_Id: 6444741970432000
    m_Localized: "\xA1Esto destruir\xE1 toda la informaci\xF3n de progreso!\n\xA1Ser\xE1
      imposible recuperar los datos!"
    m_Metadata:
      m_Items: []
  - m_Id: 6448809807777792
    m_Localized: "\xA1Estoy de acuerdo!"
    m_Metadata:
      m_Items: []
  - m_Id: 6449739378790400
    m_Localized: "\xA1Eliminar!"
    m_Metadata:
      m_Items: []
  - m_Id: 6463067136266240
    m_Localized: Eliminar partidas guardadas
    m_Metadata:
      m_Items: []
  - m_Id: 2393996019175424
    m_Localized: "\xA1Hola!\r\nSoy un desarrollador independiente que ama los juegos
      interesantes y odia que le metan informaci\xF3n innecesaria en la cara.\r\nMi
      objetivo es crear juegos geniales en los que quieras jugar sin distraerte con
      tonter\xEDas.\r\nPor eso, fundamentalmente no a\xF1ado publicidad al juego,
      para que el jugador pueda descubrir c\xF3modamente y con total inmersi\xF3n
      un nuevo mundo interesante.\r\nSi te identifica mi postura y quieres apoyarme,
      puedes hacerlo realizando una compra en el Cat\xE1logo de Objetos.\r\n\xA1Gracias!"
    m_Metadata:
      m_Items: []
  - m_Id: 20506246927945728
    m_Localized: "Renombrar campa\xF1a"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
