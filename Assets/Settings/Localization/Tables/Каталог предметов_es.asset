  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: "\u041A\u0430\u0442\u0430\u043B\u043E\u0433 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432_es"
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: f0f9d17e8b6587d41aa9cd72adc18234, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 15113195520
    m_Localized: "Barco Peque\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 42447474688
    m_Localized: Barco Mediano
    m_Metadata:
      m_Items: []
  - m_Id: 64899584000
    m_Localized: Barco Grande
    m_Metadata:
      m_Items: []
  - m_Id: 93991276544
    m_Localized: Megabarco
    m_Metadata:
      m_Items: []
  - m_Id: 130095845376
    m_Localized: Barco Mercante
    m_Metadata:
      m_Items: []
  - m_Id: 164946317312
    m_Localized: Barco de Defensa
    m_Metadata:
      m_Items: []
  - m_Id: 1137508945920
    m_Localized: "Un barco de combate ligero y econ\xF3mico, con armas d\xE9biles
      y poca durabilidad, pero muy r\xE1pido.\r\n\xA1Producido en masa y audaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 1169314353152
    m_Localized: "Un barco de combate mediano con buen armamento y durabilidad, y
      buena velocidad.\r\n\xA1El pilar de la flota!"
    m_Metadata:
      m_Items: []
  - m_Id: 1189342154752
    m_Localized: "Un barco de combate grande y pesado, con buen armamento y alta
      durabilidad, pero bastante lento y caro.\r\n\xA1Una fortaleza flotante!"
    m_Metadata:
      m_Items: []
  - m_Id: 1198267633664
    m_Localized: "Un excelente barco de combate con armas devastadoras y un casco
      casi impenetrable. Funciona bien contra el viento.\r\n\xA1No puede ser hundido
      por un monstruo marino!\r\n\xA1El terror de los mares!"
    m_Metadata:
      m_Items: []
  - m_Id: 1239740911616
    m_Localized: "Un barco peque\xF1o con armas d\xE9biles, dedicado al comercio
      entre islas amigas.\r\nSe construye autom\xE1ticamente en puertos con una Compa\xF1\xEDa
      Comercial.\r\n\xA1El motor de la econom\xEDa!"
    m_Metadata:
      m_Items: []
  - m_Id: 1260410441728
    m_Localized: "Un barco peque\xF1o con buen armamento, capaz de patrullar una
      isla amiga con un peque\xF1o asentamiento. La tripulaci\xF3n est\xE1 entrenada
      en reparaciones.\r\n\xA1Un defensor inquebrantable!"
    m_Metadata:
      m_Items: []
  - m_Id: 446968640901120
    m_Localized: "Tripulaci\xF3n Intr\xE9pida"
    m_Metadata:
      m_Items: []
  - m_Id: 447057203630080
    m_Localized: Duplica el alcance desde el cual se puede enviar un barco para capturar
      un objetivo
    m_Metadata:
      m_Items: []
  - m_Id: 447506266787840
    m_Localized: "Esp\xEDas"
    m_Metadata:
      m_Items: []
  - m_Id: 448294657527808
    m_Localized: Permite ver siempre los recursos del enemigo
    m_Metadata:
      m_Items: []
  - m_Id: 448507468124160
    m_Localized: Amansamonstruos
    m_Metadata:
      m_Items: []
  - m_Id: 448557522948096
    m_Localized: 'Un antiguo artefacto que calma a los monstruos marinos.

      Los
      monstruos atacan barcos amigos 4 veces menos seguido'
    m_Metadata:
      m_Items: []
  - m_Id: 6173132223221760
    m_Localized: Cuartel General de Defensa
    m_Metadata:
      m_Items: []
  - m_Id: 6173171863588864
    m_Localized: "Construye autom\xE1tica y gratuitamente un Barco de Defensa en
      cualquier asentamiento atacado por Piratas"
    m_Metadata:
      m_Items: []
  - m_Id: 6173362838638592
    m_Localized: Fuerte
    m_Metadata:
      m_Items: []
  - m_Id: 6173410511097856
    m_Localized: "Compa\xF1\xEDa Comercial"
    m_Metadata:
      m_Items: []
  - m_Id: 14169996906270720
    m_Localized: Puerto Grande
    m_Metadata:
      m_Items: []
  - m_Id: 14170028539711488
    m_Localized: Puerto Chico
    m_Metadata:
      m_Items: []
  - m_Id: 14170047732846592
    m_Localized: "Peque\xF1o Asentamiento"
    m_Metadata:
      m_Items: []
  - m_Id: 14170128930377728
    m_Localized: Asentamiento Pirata
    m_Metadata:
      m_Items: []
  - m_Id: 14169960243859456
    m_Localized: "Fuerte de Puerto Peque\xF1o"
    m_Metadata:
      m_Items: []
  - m_Id: 14169908599394304
    m_Localized: Fuerte de Puerto Grande
    m_Metadata:
      m_Items: []
  - m_Id: 14170914229915648
    m_Localized: Estructura defensiva con armas poderosas
    m_Metadata:
      m_Items: []
  - m_Id: 14171073122734080
    m_Localized: "Construye autom\xE1ticamente un Barco Mercante que comercia entre
      islas amigas.\r\nSolo puede haber un Barco Mercante por puerto que tenga este
      edificio"
    m_Metadata:
      m_Items: []
  - m_Id: 14171126738522112
    m_Localized: "Gran asentamiento portuario donde se pueden construir barcos.\r\nProporciona
      buenos ingresos cada d\xEDa.\r\nCuenta con poderosas armas defensivas"
    m_Metadata:
      m_Items: []
  - m_Id: 14171160276176896
    m_Localized: "Asentamiento portuario mediano donde se pueden construir barcos.\r\nProporciona
      ingresos medios cada d\xEDa.\r\nCuenta con armas defensivas medianas"
    m_Metadata:
      m_Items: []
  - m_Id: 14171190483554304
    m_Localized: "Estructura defensiva con armas poderosas.\r\nSe puede construir
      en un puerto. Aumenta el da\xF1o, la durabilidad y la recuperaci\xF3n, pero
      requiere mantenimiento diario"
    m_Metadata:
      m_Items: []
  - m_Id: 14171221789839360
    m_Localized: "Estructura defensiva con armas poderosas.\r\nSe puede construir
      en un puerto. Aumenta el da\xF1o, la durabilidad y la recuperaci\xF3n, pero
      requiere mantenimiento diario"
    m_Metadata:
      m_Items: []
  - m_Id: 14171252051742720
    m_Localized: "Peque\xF1o asentamiento donde no se pueden construir barcos.\r\nProporciona
      un ingreso peque\xF1o cada d\xEDa.\r\nNo tiene armas defensivas"
    m_Metadata:
      m_Items: []
  - m_Id: 14171282363977728
    m_Localized: "Asentamiento de piratas y bandidos.\r\nEnv\xEDa piratas en incursiones
      de saqueo a peque\xF1os asentamientos y barcos mercantes.\r\nDestruir el asentamiento
      ayuda a recuperar el bot\xEDn y aporta una peque\xF1a ganancia al tesoro"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
