MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435_en"
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: en
  m_SharedData: {fileID: 11400000, guid: 9518276203fa47047bf615ef537d0ccb, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10201665536
    m_Localized: Skip Tutorial
    m_Metadata:
      m_Items: []
  - m_Id: 49630042722304
    m_Localized: Are you sure you want to skip the tutorial?
    m_Metadata:
      m_Items: []
  - m_Id: 78875004928
    m_Localized: I'm ready!
    m_Metadata:
      m_Items: []
  - m_Id: 87823727267840
    m_Localized: Got it
    m_Metadata:
      m_Items: []
  - m_Id: 20381005058048
    m_Localized: Hey Captain, it's time to take action!
    m_Metadata:
      m_Items: []
  - m_Id: 4800835031040
    m_Localized: "The Empire has fallen, and now in these waters, it's every man
      for himself.\r\nWe have a chance to restore control \u2014 to take command
      of the archipelago into our own hands.\r\nYou must seize this chance!"
    m_Metadata:
      m_Items: []
  - m_Id: 68047378386944
    m_Localized: This is our port
    m_Metadata:
      m_Items: []
  - m_Id: 68059260850176
    m_Localized: 'It generates income every day and also has defensive weapons to
      repel enemy attacks.

      In it, we can build ships to capture neighboring
      islands'
    m_Metadata:
      m_Items: []
  - m_Id: 336016020934656
    m_Localized: Current objective
    m_Metadata:
      m_Items: []
  - m_Id: 336042835120128
    m_Localized: "This is our current target for capture \u2014 a neutral port"
    m_Metadata:
      m_Items: []
  - m_Id: 350801433268224
    m_Localized: Combat
    m_Metadata:
      m_Items: []
  - m_Id: 350805065535488
    m_Localized: To start a battle, click on the "Combat" icon
    m_Metadata:
      m_Items: []
  - m_Id: 336208875032576
    m_Localized: Let the Battle begin!
    m_Metadata:
      m_Items: []
  - m_Id: 336225761300480
    m_Localized: 'Now simply click on the target port, and a ship will be built in
      our port that will immediately sail to capture it.

      We need to spend
      a little money to build the ship'
    m_Metadata:
      m_Items: []
  - m_Id: 336373954449408
    m_Localized: Our Treasury
    m_Metadata:
      m_Items: []
  - m_Id: 336390731665408
    m_Localized: 'Ships act on their own, trying to capture the designated target.

      A
      daily fee is required to maintain the ships.

      Here you can track the
      state of our treasury, as well as current income and expenses'
    m_Metadata:
      m_Items: []
  - m_Id: 336634139709440
    m_Localized: Day and Wind
    m_Metadata:
      m_Items: []
  - m_Id: 336652716281856
    m_Localized: 'This shows the direction and strength of the wind, which affect
      the speed of our ships.

      It also shows the number and time of the current
      day; when the indicator fills up completely, a new day will begin'
    m_Metadata:
      m_Items: []
  - m_Id: 336844454694912
    m_Localized: Small Settlements
    m_Metadata:
      m_Items: []
  - m_Id: 336863417143296
    m_Localized: 'To build new ships and develop our ports, it would be good to capture
      several small settlements that are nearby.

      They provide a small income
      every day.

      Click on a settlement to create a ship and send it to capture
      that settlement'
    m_Metadata:
      m_Items: []
  - m_Id: 337204904792064
    m_Localized: Defensive Forts
    m_Metadata:
      m_Items: []
  - m_Id: 337218574028800
    m_Localized: 'Large ports usually have defensive Forts nearby, equipped with
      powerful weapons.

      Control over the forts will help us protect our ports.

      Click
      on the fort several times to create multiple ships and capture it'
    m_Metadata:
      m_Items: []
  - m_Id: 338234652561408
    m_Localized: Let's capture the target port!
    m_Metadata:
      m_Items: []
  - m_Id: 338255955431424
    m_Localized: 'Excellent, Captain, now you understand what needs to be done!

      Let''s
      capture the target port!

      Click on the port several times to create
      multiple ships and capture our target'
    m_Metadata:
      m_Items: []
  - m_Id: 338554204000256
    m_Localized: A fine start, Captain!
    m_Metadata:
      m_Items: []
  - m_Id: 338612706152448
    m_Localized: 'Now you are ready to take control of this beautiful archipelago!

      But
      we are not the only ones who decided to take advantage of the current lawlessness.

      The
      enemy clan has also begun to grow stronger.

      Act before they get ahead
      of you!'
    m_Metadata:
      m_Items: []
  - m_Id: 338811226755072
    m_Localized: Item & Goods Catalog
    m_Metadata:
      m_Items: []
  - m_Id: 338824501727232
    m_Localized: 'You can find more information about ships and construction in the
      Item Catalog.

      You can also make useful purchases there'
    m_Metadata:
      m_Items: []
  - m_Id: 338983830753280
    m_Localized: Forward, Captain!
    m_Metadata:
      m_Items: []
  - m_Id: 338997554515968
    m_Localized: 'Great achievements await us!

      Lead us, and we will follow
      you through fire and water!'
    m_Metadata:
      m_Items: []
  - m_Id: 339756840980480
    m_Localized: Let's go!
    m_Metadata:
      m_Items: []
  - m_Id: 339995278774272
    m_Localized: Got it
    m_Metadata:
      m_Items: []
  - m_Id: 340294005493760
    m_Localized: Good
    m_Metadata:
      m_Items: []
  - m_Id: 340578014400512
    m_Localized: Forward!
    m_Metadata:
      m_Items: []
  - m_Id: 434347921444864
    m_Localized: Hide hints
    m_Metadata:
      m_Items: []
  - m_Id: 434378439200768
    m_Localized: Show hints
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
