  - m_Id: 64899584000
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 93991276544
    m_Localized: "\u041C\u0435\u0433\u0430-\u043A\u043E\u0440\u0430\u0431\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 130095845376
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 164946317312
    m_Localized: "\u0417\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 1137508945920
    m_Localized: "\u041B\u0451\u0433\u043A\u0438\u0439 \u0434\u0435\u0448\u0451\u0432\u044B\u0439
      \u0431\u043E\u0435\u0432\u043E\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C
      \u0441\u043E \u0441\u043B\u0430\u0431\u044B\u043C \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C
      \u0438 \u043D\u0438\u0437\u043A\u043E\u0439 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E,
      \u043D\u043E \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0449\u0438\u0439 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E.\n\u041C\u0430\u0441\u0441\u043E\u0432\u044B\u0439
      \u0438 \u0434\u0435\u0440\u0437\u043A\u0438\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 1169314353152
    m_Localized: "\u0421\u0440\u0435\u0434\u043D\u0438\u0439 \u0431\u043E\u0435\u0432\u043E\u0439
      \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u0441 \u043D\u0435\u043F\u043B\u043E\u0445\u0438\u043C
      \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E,
      \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u043D\u0435\u043F\u043B\u043E\u0445\u043E\u0439
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E.\n\u041E\u043F\u043E\u0440\u0430
      \u0444\u043B\u043E\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 1189342154752
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0442\u044F\u0436\u0451\u043B\u044B\u0439
      \u0431\u043E\u0435\u0432\u043E\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C
      \u0441 \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u043C
      \u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E,
      \u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439
      \u0438 \u0434\u043E\u0440\u043E\u0433\u043E\u0439.\n\u041F\u043B\u0430\u0432\u0443\u0447\u0430\u044F
      \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 1198267633664
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u044B\u0439 \u0431\u043E\u0435\u0432\u043E\u0439
      \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u0441 \u0440\u0430\u0437\u0440\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C \u0438 \u043F\u043E\u0447\u0442\u0438
      \u043D\u0435\u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u043C\u044B\u043C
      \u043A\u043E\u0440\u043F\u0443\u0441\u043E\u043C, \u0445\u043E\u0440\u043E\u0448\u043E
      \u0438\u0434\u0451\u0442 \u043F\u0440\u043E\u0442\u0438\u0432 \u0432\u0435\u0442\u0440\u0430.\n\u041D\u0435
      \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u043F\u043E\u0442\u043E\u043F\u043B\u0435\u043D
      \u043C\u043E\u0440\u0441\u043A\u0438\u043C \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u0435\u043C!\n\u0413\u0440\u043E\u0437\u0430
      \u043C\u043E\u0440\u0435\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 1239740911616
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C
      \u0441\u043E \u0441\u043B\u0430\u0431\u044B\u043C \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C,
      \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u044E\u0449\u0438\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044E \u043C\u0435\u0436\u0434\u0443
      \u0434\u0440\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
      \u043E\u0441\u0442\u0440\u043E\u0432\u0430\u043C\u0438.\n\u0421\u0442\u0440\u043E\u0438\u0442\u0441\u044F
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u0432 \u043F\u043E\u0440\u0442\u0443 \u0441 \u0422\u043E\u0440\u0433\u043E\u0432\u043E\u0439
      \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u0435\u0439.\n\u0414\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044C
      \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043A\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 1260410441728
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C
      \u0441 \u043D\u0435\u043F\u043B\u043E\u0445\u0438\u043C \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C,
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0439 \u043E\u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043B\u044F\u0442\u044C
      \u043F\u0430\u0442\u0440\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
      \u0434\u0440\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0433\u043E
      \u043E\u0441\u0442\u0440\u043E\u0432\u0430 \u0441 \u043C\u0430\u043B\u044B\u043C
      \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0435\u043C. \u041A\u043E\u043C\u0430\u043D\u0434\u0430
      \u043E\u0431\u0443\u0447\u0435\u043D\u0430 \u0440\u0435\u043C\u043E\u043D\u0442\u043D\u043E\u043C\u0443
      \u0434\u0435\u043B\u0443.\n\u0421\u0442\u043E\u0439\u043A\u0438\u0439 \u0437\u0430\u0449\u0438\u0442\u043D\u0438\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 446968640901120
    m_Localized: "\u0411\u0435\u0441\u0441\u0442\u0440\u0430\u0448\u043D\u0430\u044F
      \u043A\u043E\u043C\u0430\u043D\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 447057203630080
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0432 2 \u0440\u0430\u0437\u0430 \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
      \u043A\u0443\u0434\u0430 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0441\u043B\u0430\u0442\u044C
      \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u0434\u043B\u044F \u0437\u0430\u0445\u0432\u0430\u0442\u0430
      \u0446\u0435\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 447506266787840
    m_Localized: "\u0428\u043F\u0438\u043E\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 448294657527808
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u0438\u0434\u0435\u0442\u044C \u0440\u0435\u0441\u0443\u0440\u0441\u044B
      \u0432\u0440\u0430\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 448507468124160
    m_Localized: "\u0423\u0441\u043C\u0438\u0440\u0438\u0442\u0435\u043B\u044C \u0447\u0443\u0434\u043E\u0432\u0438\u0449"
    m_Metadata:
      m_Items: []
  - m_Id: 448557522948096
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u0438\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442,
      \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u044E\u0449\u0438\u0439
      \u043C\u043E\u0440\u0441\u043A\u0438\u0445 \u043C\u043E\u043D\u0441\u0442\u0440\u043E\u0432.\n\u0427\u0443\u0434\u043E\u0432\u0438\u0449\u0430
      \u043D\u0430\u043F\u0430\u0434\u0430\u044E\u0442 \u043D\u0430 \u0434\u0440\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u043A\u043E\u0440\u0430\u0431\u043B\u0438 \u0432 4 \u0440\u0430\u0437\u0430
      \u0440\u0435\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6173132223221760
    m_Localized: "\u0428\u0442\u0430\u0431 \u043E\u0431\u043E\u0440\u043E\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6173171863588864
    m_Localized: "\u0410\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E \u0441\u0442\u0440\u043E\u0438\u0442
      \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C
      \u0432 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0435, \u043D\u0430
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043D\u0430\u043F\u0430\u043B\u0438
      \u041F\u0438\u0440\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6173362838638592
    m_Localized: "\u0424\u043E\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6173410511097856
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u044F \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044F"
    m_Metadata:
