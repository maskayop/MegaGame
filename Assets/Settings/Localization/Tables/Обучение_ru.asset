  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: "\u041E\u0431\u0443\u0447\u0435\u043D\u0438\u0435_ru"
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: 9518276203fa47047bf615ef537d0ccb, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 10201665536
    m_Localized: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 78875004928
    m_Localized: "\u042F \u0433\u043E\u0442\u043E\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 4800835031040
    m_Localized: "\u0418\u043C\u043F\u0435\u0440\u0438\u044F \u0440\u0430\u0441\u043F\u0430\u043B\u0430\u0441\u044C,
      \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u0432 \u044D\u0442\u0438\u0445
      \u0432\u043E\u0434\u0430\u0445 \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0430\u043C
      \u0437\u0430 \u0441\u0435\u0431\u044F.\n\u0423 \u043D\u0430\u0441 \u0435\u0441\u0442\u044C
      \u0448\u0430\u043D\u0441 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C - \u0432\u0437\u044F\u0442\u044C
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0430\u0440\u0445\u0438\u043F\u0435\u043B\u0430\u0433\u043E\u043C
      \u0432 \u0441\u0432\u043E\u0438 \u0440\u0443\u043A\u0438. \u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B
      \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u044D\u0442\u0438\u043C \u0448\u0430\u043D\u0441\u043E\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 20381005058048
    m_Localized: "\u042D\u0439, \u041A\u0430\u043F\u0438\u0442\u0430\u043D, \u043F\u0440\u0438\u0448\u043B\u043E
      \u0432\u0440\u0435\u043C\u044F \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 49630042722304
    m_Localized: "\u0412\u044B \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043E\u0442\u0438\u0442\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 68047378386944
    m_Localized: "\u042D\u0442\u043E \u043D\u0430\u0448 \u043F\u043E\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 68059260850176
    m_Localized: "\u041E\u043D \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u0434\u043E\u0445\u043E\u0434
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C, \u0430 \u0442\u0430\u043A\u0436\u0435
      \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u043C
      \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C \u0434\u043B\u044F
      \u043E\u0442\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445
      \u0430\u0442\u0430\u043A.\n\u0412 \u043D\u0451\u043C \u043C\u044B \u043C\u043E\u0436\u0435\u043C
      \u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043A\u043E\u0440\u0430\u0431\u043B\u0438
      \u0434\u043B\u044F \u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445
      \u043E\u0441\u0442\u0440\u043E\u0432\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 87823727267840
    m_Localized: "\u041F\u043E\u043D\u044F\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 336016020934656
    m_Localized: "\u0422\u0435\u043A\u0443\u0449\u0430\u044F \u0446\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 336042835120128
    m_Localized: "\u042D\u0442\u043E \u043D\u0430\u0448\u0430 \u0442\u0435\u043A\u0443\u0449\u0430\u044F
      \u0446\u0435\u043B\u044C \u0434\u043B\u044F \u0437\u0430\u0445\u0432\u0430\u0442\u0430
      - \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 336208875032576
    m_Localized: "\u0414\u0430 \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F \u0411\u043E\u0439!"
    m_Metadata:
      m_Items: []
  - m_Id: 336225761300480
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u0446\u0435\u043B\u0435\u0432\u043E\u0439
      \u043F\u043E\u0440\u0442, \u0438 \u0432 \u043D\u0430\u0448\u0435\u043C \u043F\u043E\u0440\u0442\u0443
      \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043D
      \u043A\u043E\u0440\u0430\u0431\u043B\u044C, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0441\u0440\u0430\u0437\u0443 \u0436\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0442\u044C \u044D\u0442\u0443
      \u0446\u0435\u043B\u044C.\n\u041D\u0430 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u043A\u043E\u0440\u0430\u0431\u043B\u044F \u043D\u0430\u043C \u043D\u0443\u0436\u043D\u043E
      \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0434\u0435\u043D\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 336373954449408
    m_Localized: "\u041D\u0430\u0448\u0430 \u043A\u0430\u0437\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 336390731665408
    m_Localized: "\u041A\u043E\u0440\u0430\u0431\u043B\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442
      \u0441\u0430\u043C\u0438, \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C
      \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u0443\u044E
      \u0446\u0435\u043B\u044C.\n\u041A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u043F\u043B\u0430\u0442\u0430
      \u043D\u0430 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u043A\u043E\u0440\u0430\u0431\u043B\u0435\u0439.\n\u0417\u0434\u0435\u0441\u044C
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0442\u0441\u043B\u0435\u0436\u0438\u0432\u0430\u0442\u044C
      \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043D\u0430\u0448\u0435\u0439
      \u043A\u0430\u0437\u043D\u044B, \u0430 \u0442\u0430\u043A\u0436\u0435 \u0442\u0435\u043A\u0443\u0449\u0438\u0435
      \u0434\u043E\u0445\u043E\u0434\u044B \u0438 \u0442\u0440\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 336634139709440
    m_Localized: "\u0414\u0435\u043D\u044C \u0438 \u0432\u0435\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 336652716281856
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0438 \u0441\u0438\u043B\u0430
      \u0432\u0435\u0442\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0432\u043B\u0438\u044F\u044E\u0442 \u043D\u0430 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043D\u0430\u0448\u0438\u0445
      \u043A\u043E\u0440\u0430\u0431\u043B\u0435\u0439.\n\u0422\u0430\u043A\u0436\u0435
      \u0437\u0434\u0435\u0441\u044C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u043E\u043C\u0435\u0440 \u0438 \u0432\u0440\u0435\u043C\u044F \u0442\u0435\u043A\u0443\u0449\u0435\u0433\u043E
      \u0434\u043D\u044F; \u043A\u043E\u0433\u0434\u0430 \u0438\u043D\u0434\u0438\u043A\u0430\u0442\u043E\u0440
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u0441\u044F,
      \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442 \u043D\u043E\u0432\u044B\u0439
      \u0434\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 336844454694912
    m_Localized: "\u041C\u0430\u043B\u044B\u0435 \u041F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 336863417143296
    m_Localized: "\u0414\u043B\u044F \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430
      \u043D\u043E\u0432\u044B\u0445 \u043A\u043E\u0440\u0430\u0431\u043B\u0435\u0439
      \u0438 \u0440\u0430\u0437\u0432\u0438\u0442\u0438\u044F \u043D\u0430\u0448\u0438\u0445
      \u043F\u043E\u0440\u0442\u043E\u0432 \u0445\u043E\u0440\u043E\u0448\u043E \u0431\u044B\u043B\u043E
      \u0431\u044B \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043E\u0441\u0442\u0440\u043E\u0432\u043E\u0432 \u0441 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438
      \u041F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u044F\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
      \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0451\u043A\u0443.\n\u041E\u043D\u0438
      \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0434\u043E\u0445\u043E\u0434 \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C.\n\u041D\u0430\u0436\u043C\u0438
      \u043D\u0430 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0435, \u0447\u0442\u043E\u0431\u044B
      \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043A\u043E\u0440\u0430\u0431\u043B\u044C
      \u0438 \u043F\u043E\u0441\u043B\u0430\u0442\u044C \u0435\u0433\u043E \u0437\u0430\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0442\u044C
      \u044D\u0442\u043E \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 337204904792064
    m_Localized: "\u0417\u0430\u0449\u0438\u0442\u043D\u044B\u0435 \u0424\u043E\u0440\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 337218574028800
    m_Localized: "\u041E\u043A\u043E\u043B\u043E \u0411\u043E\u043B\u044C\u0448\u0438\u0445
      \u043F\u043E\u0440\u0442\u043E\u0432 \u043E\u0431\u044B\u0447\u043D\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0442\u0441\u044F
      \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0435 \u0424\u043E\u0440\u0442\u044B,
      \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0449\u0438\u0435 \u043C\u043E\u0449\u043D\u044B\u043C
      \u0432\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C.\n\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
      \u043D\u0430\u0434 \u0444\u043E\u0440\u0442\u0430\u043C\u0438 \u043F\u043E\u043C\u043E\u0436\u0435\u0442
      \u043D\u0430\u043C \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C \u043D\u0430\u0448\u0438
      \u043F\u043E\u0440\u0442\u044B.\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437 \u043D\u0430
      \u0444\u043E\u0440\u0442, \u0447\u0442\u043E\u0431\u044B \u0441\u043E\u0437\u0434\u0430\u0442\u044C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0440\u0430\u0431\u043B\u0435\u0439
      \u0438 \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C \u044D\u0442\u043E\u0442
      \u0444\u043E\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 338234652561408
    m_Localized: "\u0417\u0430\u0445\u0432\u0430\u0442\u0438\u043C \u0446\u0435\u043B\u0435\u0432\u043E\u0439
      \u043F\u043E\u0440\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 338255955431424
    m_Localized: "\u041E\u0442\u043B\u0438\u0447\u043D\u043E, \u041A\u0430\u043F\u0438\u0442\u0430\u043D,
      \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435,
      \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0434\u0435\u043B\u0430\u0442\u044C!\n\u0414\u0430\u0432\u0430\u0439\u0442\u0435
      \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u043C \u0446\u0435\u043B\u0435\u0432\u043E\u0439
      \u043F\u043E\u0440\u0442!\n\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0440\u0430\u0437 \u043D\u0430 \u043F\u043E\u0440\u0442, \u0447\u0442\u043E\u0431\u044B
      \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043A\u043E\u0440\u0430\u0431\u043B\u0435\u0439 \u0438 \u0437\u0430\u0445\u0432\u0430\u0442\u0438\u0442\u044C
      \u043D\u0430\u0448\u0443 \u0446\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 338554204000256
    m_Localized: "\u041F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u043E\u0435 \u043D\u0430\u0447\u0430\u043B\u043E,
      \u043A\u0430\u043F\u0438\u0442\u0430\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 338612706152448
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u0433\u043E\u0442\u043E\u0432\u044B
      \u0432\u0437\u044F\u0442\u044C \u043F\u043E\u0434 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
      \u044D\u0442\u043E\u0442 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0439
      \u0430\u0440\u0445\u0438\u043F\u0435\u043B\u0430\u0433!\n\u041D\u043E \u043D\u0435
      \u043C\u044B \u043E\u0434\u043D\u0438 \u0440\u0435\u0448\u0438\u043B\u0438
      \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0441\u043B\u0443\u0447\u0438\u0432\u0448\u0435\u0439\u0441\u044F \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0435\u0439
      \u0431\u0435\u0437\u0437\u0430\u043A\u043E\u043D\u0438\u044F. \u0412\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0439
      \u043A\u043B\u0430\u043D \u0442\u043E\u0436\u0435 \u043D\u0430\u0447\u0430\u043B
      \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F.\n\u0414\u0435\u0439\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
      \u043F\u043E\u043A\u0430 \u0432\u0430\u0441 \u043D\u0435 \u043E\u043F\u0435\u0440\u0435\u0434\u0438\u043B\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 338811226755072
    m_Localized: "\u041A\u0430\u0442\u0430\u043B\u043E\u0433 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432
      \u0438 \u0442\u043E\u0432\u0430\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 338824501727232
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
      \u043E \u043A\u043E\u0440\u0430\u0431\u043B\u044F\u0445 \u0438 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435
      \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0443\u0437\u043D\u0430\u0442\u044C
      \u0432 \u041A\u0430\u0442\u0430\u043B\u043E\u0433\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432.\n\u0422\u0430\u043C
      \u0436\u0435 \u043C\u043E\u0436\u043D\u043E \u0441\u043E\u0432\u0435\u0440\u0448\u0430\u0442\u044C
      \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435 \u043F\u043E\u043A\u0443\u043F\u043A\u0438"
    m_Metadata:
