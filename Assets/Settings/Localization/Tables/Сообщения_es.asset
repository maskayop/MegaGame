  m_TableData:
  - m_Id: 191898914816
    m_Localized: "\xA1Demasiado lejos del puerto!"
    m_Metadata:
      m_Items: []
  - m_Id: 326640930816
    m_Localized: "\xA1No se puede enviar el barco! \xA1Muy lejos del puerto!"
    m_Metadata:
      m_Items: []
  - m_Id: 528768634880
    m_Localized: "\xA1No navegamos hasta all\xED! \xA1Est\xE1 demasiado lejos del
      puerto!"
    m_Metadata:
      m_Items: []
  - m_Id: 4026286499500032
    m_Localized: "\xA1Este puerto no es el objetivo! El objetivo es "
    m_Metadata:
      m_Items: []
  - m_Id: 4026295106211840
    m_Localized: "\xA1Es demasiado pronto para capturar este puerto! Nuestro objetivo
      es "
    m_Metadata:
      m_Items: []
  - m_Id: 4026302475603968
    m_Localized: "\xA1No deber\xEDamos capturar este puerto ahora! Nuestro objetivo
      es "
    m_Metadata:
      m_Items: []
  - m_Id: 6213526319337472
    m_Localized: "\xA1Nuestro barco est\xE1 siendo atacado por un monstruo marino:
      <color=#D580FF>Nekark</color> !"
    m_Metadata:
      m_Items: []
  - m_Id: 6213568690196480
    m_Localized: "\xA1Perdimos el barco! Fue el monstruo marino \u2014 <color=#D580FF>Nekark</color>
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 6213585958146048
    m_Localized: "\xA1Oh no! <color=#D580FF>Nekark</color>, el monstruo marino, \xA1captur\xF3
      nuestra nave!"
    m_Metadata:
      m_Items: []
  - m_Id: 9879769580638208
    m_Localized: "\xA1Nuestro barco est\xE1 siendo atacado por un monstruo marino:
      <color=#66FFB2>Nafa-Ivel</color> !"
    m_Metadata:
      m_Items: []
  - m_Id: 9879847082987520
    m_Localized: "\xA1Perdimos el barco! Fue el monstruo marino \u2014 <color=#66FFB2>Nafa-Ivel</color>
      !"
    m_Metadata:
      m_Items: []
  - m_Id: 9879852921458688
    m_Localized: "\xA1Oh no! <color=#66FFB2>Nafa-Ivel</color>, el monstruo marino,
      \xA1captur\xF3 nuestra nave !"
    m_Metadata:
      m_Items: []
  - m_Id: 10218462703063040
    m_Localized: "\xA1<color=#999999>Piratas</color>! Atacaron nuestro asentamiento
      en "
    m_Metadata:
      m_Items: []
  - m_Id: 10218520861282304
    m_Localized: "\xA1Nuestro asentamiento ha sido atacado por <color=#999999>Piratas</color>
      ! "
    m_Metadata:
      m_Items: []
  - m_Id: 10218525336604672
    m_Localized: "\xA1Nos atacaron los <color=#999999>Piratas</color> ! \xA1Nuestro
      asentamiento est\xE1 en peligro!"
    m_Metadata:
      m_Items: []
  - m_Id: 8725106797907968
    m_Localized: "termin\xF3 de construir el Fuerte"
    m_Metadata:
      m_Items: []
  - m_Id: 8725143225438208
    m_Localized: ha construido un Fuerte
    m_Metadata:
      m_Items: []
  - m_Id: 8725148510261248
    m_Localized: "ha completado la construcci\xF3n del Fuerte"
    m_Metadata:
      m_Items: []
  - m_Id: 8753933016174592
    m_Localized: "ha abierto una Compa\xF1\xEDa Comercial"
    m_Metadata:
      m_Items: []
  - m_Id: 8753936191262720
    m_Localized: "ha fundado una Compa\xF1\xEDa Comercial"
    m_Metadata:
      m_Items: []
  - m_Id: 8753937860595712
    m_Localized: "estableci\xF3 una Compa\xF1\xEDa Comercial"
