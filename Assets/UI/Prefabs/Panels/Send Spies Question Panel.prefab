    - target: {fileID: 6424266628885937747, guid: 79e92497e0ba6e84f8dba88e55a9a1a1, type: 3}
      propertyPath: m_text
      value: "\u041F\u043E\u0441\u043B\u0430\u0442\u044C \u0448\u043F\u0438\u043E\u043D\u043E\u0432
        \u0432\u043E \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0435 \u043F\u043E\u0440\u0442\u044B?\n\n<color=#FFFFFF>\u042D\u0442\u043E
        \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
        \u0432\u0438\u0434\u0435\u0442\u044C \u0440\u0435\u0441\u0443\u0440\u0441\u044B
        \u0432\u0440\u0430\u0433\u0430 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
        \u043E\u0434\u043D\u043E\u0439 \u0431\u0438\u0442\u0432\u044B.\n\u0421\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
        \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
        \u0432\u0440\u0430\u0436\u0435\u0441\u043A\u0438\u0445 \u043F\u043E\u0440\u0442\u043E\u0432\n</color>"
      objectReference: {fileID: 0}
