    - target: {fileID: 6395007745022617812, guid: 79e92497e0ba6e84f8dba88e55a9a1a1, type: 3}
      propertyPath: m_Name
      value: No Ads Panel
      objectReference: {fileID: 0}
    - target: {fileID: 6424266628885937747, guid: 79e92497e0ba6e84f8dba88e55a9a1a1, type: 3}
      propertyPath: m_text
      value: "\u041F\u0440\u0438\u0432\u0435\u0442!\n\u042F \u044F\u0432\u043B\u044F\u044E\u0441\u044C
        \u043E\u0434\u0438\u043D\u043E\u0447\u043D\u044B\u043C \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u043E\u043C,
        \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043B\u044E\u0431\u0438\u0442
        \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0435 \u0438\u0433\u0440\u044B
        \u0438 \u043D\u0435\u043D\u0430\u0432\u0438\u0434\u0438\u0442, \u043A\u043E\u0433\u0434\u0430
        \u0432 \u043B\u0438\u0446\u043E \u043F\u0438\u0445\u0430\u044E\u0442 \u043D\u0435\u043D\u0443\u0436\u043D\u0443\u044E
        \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E.\n\u041C\u043E\u044F
        \u0446\u0435\u043B\u044C - \u0434\u0435\u043B\u0430\u0442\u044C \u043A\u043B\u0430\u0441\u0441\u043D\u044B\u0435
        \u0438\u0433\u0440\u044B, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0438\u0433\u0440\u0430\u0442\u044C,
        \u043D\u0435 \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u044F\u0441\u044C
        \u043F\u0440\u0438 \u044D\u0442\u043E\u043C \u043D\u0430 \u0432\u0441\u044F\u043A\u0443\u044E
        \u0435\u0440\u0443\u043D\u0434\u0443.\n\u041F\u043E\u044D\u0442\u043E\u043C\u0443
        \u044F \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0438\u0430\u043B\u044C\u043D\u043E
        \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E \u0432 \u0438\u0433\u0440\u0443
        \u0440\u0435\u043A\u043B\u0430\u043C\u0443, \u0447\u0442\u043E\u0431\u044B
        \u0438\u0433\u0440\u043E\u043A \u043C\u043E\u0433 \u0441 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043E\u043C
        \u0438 \u043F\u043E\u043B\u043D\u044B\u043C \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0438\u0435\u043C
        \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0434\u043B\u044F
        \u0441\u0435\u0431\u044F \u043D\u043E\u0432\u044B\u0439 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0439
        \u043C\u0438\u0440 \u0438\u0433\u0440\u044B.\n\u0415\u0441\u043B\u0438 \u0412\u0430\u043C
        \u0431\u043B\u0438\u0437\u043A\u0430 \u043C\u043E\u044F \u043F\u043E\u0437\u0438\u0446\u0438\u044F,
        \u0438 \u0412\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u0442\u044C
        \u043C\u0435\u043D\u044F, \u0442\u043E \u043C\u043E\u0436\u0435\u0442\u0435
        \u044D\u0442\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C, \u0441\u043E\u0432\u0435\u0440\u0448\u0438\u0432
        \u043F\u043E\u043A\u0443\u043F\u043A\u0443 \u0432 \u041A\u0430\u0442\u0430\u043B\u043E\u0433\u0435
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432.\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E!"
      objectReference: {fileID: 0}
